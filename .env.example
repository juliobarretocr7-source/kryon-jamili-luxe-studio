# Preencha com os valores do seu projeto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor. NUNCA prefixar com NEXT_PUBLIC_, NUNCA expor ao navegador.
# Usada apenas por rotinas de sistema (webhooks, jobs agendados) que precisam
# contornar RLS de propósito — nunca pelo código que atende o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão direta ao Postgres, usada pelos scripts de teste em supabase/tests/.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
